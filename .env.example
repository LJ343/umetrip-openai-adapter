# FlyAI / 8002 独立配置。不要复用航旅纵横 / 8000 的配置或访问密钥。
LLM_BASE_URL=https://your-llm-provider.example/v1
LLM_MODEL=
LLM_API_KEY=
FLYAI_API_KEY=
# configure.py 自动生成独立的调用方访问密钥；不等于上面两种上游密钥。
PROXY_API_KEYS=
PUBLIC_MODEL=flyai-travel
# 填写 command -v node 返回的绝对路径；Node >= 18。
NODE_BIN=/usr/bin/node
FLYAI_CLI_PATH=runtime/flyai-bundle.cjs
STATE_DIR=state
MAX_CONCURRENT=2
REQUEST_TIMEOUT_SECONDS=240
LLM_TIMEOUT_SECONDS=90
TOOL_TIMEOUT_SECONDS=100
MAX_TOOL_ROUNDS=8
MAX_TOOL_CALLS=16
SESSION_TTL_SECONDS=86400
MAX_SESSIONS=500
MAX_SESSION_BYTES=1048576
MAX_TOOL_OUTPUT_BYTES=524288
MAX_REQUEST_BYTES=524288
MAX_OUTPUT_TOKENS=4096
# 按模型配置，例如 {"enable_thinking":false}；不可覆盖 model/messages/tools/stream。
LLM_EXTRA_BODY_JSON={}
# 默认关闭完整链路记录；开启后包含问答、原始模型 SSE 和工具结果，仅供私有排障。
RECORD_CONVERSATIONS=false
