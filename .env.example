# 复制为 .env 后按需修改：cp .env.example .env（install.sh 首次运行会自动复制）

# 监听地址和端口。对外地址即 http://服务器公网IP:PORT/v1/chat/completions
HOST=0.0.0.0
PORT=8000

# 上游生产 SSE 接口；灰度环境只需将域名改为 grayassistant.umetrip.com。
# 显式设置此项；代码未配置时的历史兜底仍为灰度。
UPSTREAM_URL=https://assistant.umetrip.com/gateway/api/web/sse/v1/chat/completions

# 允许的模型 ID，逗号分隔；留空表示不校验
ALLOWED_MODELS=qianrang

# ---- 鉴权模式（二选一）----
# 1) 透传模式（默认）：PROXY_API_KEYS 留空，客户端填写上游的 apiKey，代理原样转发给上游校验
# 2) 独立 key 模式：设置 PROXY_API_KEYS（对外发放，逗号分隔多个），代理用 UPSTREAM_API_KEY 调上游，
#    这样上游 key 不会暴露给管理后台。服务走明文 HTTP，强烈建议用这种模式。生成随机 key：openssl rand -hex 24 | sed 's/^/sk-/'
PROXY_API_KEYS=
UPSTREAM_API_KEY=

# 上游超时（秒）：连接超时；读超时 = 两次收到数据之间的最长间隔
UPSTREAM_CONNECT_TIMEOUT=10
UPSTREAM_READ_TIMEOUT=300

# ---- 输出处理（以下均为默认值，需要修改时去掉 # 号）----
# 默认完整拼接上游文字，不人为增加段间空行；如确实需要可改成 '\n\n'
TEXT_END_SEPARATOR=''
# 必须为 false 才保留全部正文。true 是旧版只保留最后一段的兼容行为，不推荐。
NONSTREAM_FINAL_SEGMENT_ONLY=false
# 删除自家 App 渲染用的卡片标签，如 <flightstatuslist_card>...</flightstatuslist_card>
STRIP_CARDS=true
# CARD_TAG_PATTERN='[A-Za-z0-9_]+_card'
# 把上游的思考过程转成 delta.reasoning_content（DeepSeek 风格）输出
EMIT_REASONING=true
# 流式超过多少秒没有输出就发一个空内容 chunk 保活，0 表示关闭
# HEARTBEAT_INTERVAL=3
# 流式请求立即建立 SSE。6 秒仍无正文时，仅添加一次等待提示，不发送结束标记。
# 已经开始输出正文/拒绝信息/原生工具调用时，不再添加提示；0 可关闭提示。
STREAM_WAIT_AFTER=6
STREAM_WAIT_MESSAGE='正在处理，请稍等。\n\n'
# 可选 /v1/keepalive/chat/completions 的非流式 JSON 空白保活（原入口不受影响）。
# 3 秒未完成先发 JSON 空白，之后每 3 秒一次；只解决读取空闲超时，不解决固定总时限。
JSON_KEEPALIVE_AFTER=3
JSON_KEEPALIVE_INTERVAL=3

# v2 文档要求的上游请求头。客户端可发送 session_id 或旧的 x-session-id。
# 同一对话复用相同 ID，不同用户/新对话用不同 ID；未带标识时每个请求生成新 ID。
SESSION_HEADER=session_id

# 仅当平台无法传会话头、且上游不读取 messages 历史时启用。
# 普通文本多轮完整放入本次输入；系统/开发者角色独立保留。
# 工具调用、多模态、有明确会话头的请求不改写。不会补上个人登录或业务会话。
PACK_HISTORY_WITHOUT_SESSION=false

# uvicorn 进程数，2 核机器建议 2
WORKERS=2
LOG_LEVEL=INFO

# 完整问答记录：包含平台原始 messages、实际上游输入、过滤前 SSE、实际下游正文。
# 仅记录鉴权成功的聊天请求；正文可能包含个人信息，仅服务用户/root 可读。
# 服务器排障时可启用；默认关闭。systemd 部署目录建议 /var/log/openai-proxy/conversations。
CONVERSATION_LOG_ENABLED=false
CONVERSATION_LOG_DIR=./logs/conversations
CONVERSATION_LOG_RETENTION_DAYS=3
CONVERSATION_LOG_MAX_BYTES=16777216
CONVERSATION_LOG_TOTAL_BYTES=268435456

# 仅连接建立前失败最多重连 1 次；读/写失败、已接收请求、已输出部分内容不重放。
UPSTREAM_CONNECT_RETRIES=1
UPSTREAM_CONNECT_RETRY_DELAY=0.25
# 上游整轮最多 180 秒（包括连接、重连、生成）；0 关闭总上限。
UPSTREAM_TOTAL_TIMEOUT=180
# 仅 /v1/keepalive/chat/completions 的普通文本 stream:true 可播报失败并完成语音回复。
# 本地失败说明用 content + stop + [DONE] 返回，日志仍保留真实上游失败。
# 原 /v1/chat/completions、非流式、结构化 JSON/纯音频、部分原生工具参数保持严格错误语义。
VOICE_ERROR_FALLBACK_ENABLED=false
